{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceRoot}/build/BlinkLED.elf",
      "device": "STM32F407VG",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "gdbPath": "gdb-multiarch",
      "toolchainPrefix": "arm-none-eabi",
      "runToEntryPoint": "main",
      "preLaunchCommands": [
        "set mem inaccessible-by-default off"
      ],
      "postLaunchCommands": [
        "monitor reset halt",
        "load",
        "monitor reset halt"
      ],
      "swoConfig": {
        "enabled": true,
        "cpuFrequency": 168000000,
        "swoFrequency": 2000000,
        "source": "probe",
        "decoders": [
          {
            "type": "console",
            "label": "ITM",
            "port": 0
          }
        ]
      }
    }
  ]
}